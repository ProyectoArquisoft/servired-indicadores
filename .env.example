# Variables de servired-indicadores (las mismas que pone servired-infra/compose).
# Copia a .env (no se commitea). En local, appsettings.Development.json ya trae valores para Docker.

# PostgreSQL (Supabase): JDBC, URI o cadena de Npgsql. Puerto 5432 (directo o session pooler).
DB_URL=jdbc:postgresql://db.<proyecto>.supabase.co:5432/postgres?sslmode=require
DB_USER=svc_indicadores
DB_PASSWORD=
DB_SCHEMA=indicadores

# RabbitMQ. Vacío = consumidor apagado (la API sigue funcionando).
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Supabase Auth: solo para GET /api/indicadores/export. Usar UNA de las dos (pregunta §11.5 del brief).
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_JWKS_URL=https://<proyecto>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=

# Opcional
# Swagger__Habilitado=true
# Patrones__RadioMetros=1000
# Patrones__VentanaDias=90
