{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrarAlIniciar": true
  },
  "RabbitMq": {
    "DeclararTopologia": true,
    "Prefetch": 10,
    "Reintentos": 3
  },
  "Patrones": {
    "RadioMetros": 1000,
    "VentanaDias": 90
  },
  "Swagger": {
    "Habilitado": false
  }
}
